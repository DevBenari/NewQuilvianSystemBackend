{
  "AppInfo": {
    "Name": "Quilvian System Backend",
    "ApiVersion": "v1",
    "Environment": "Default"
  },
  "FrontendCompatibility": {
    "MinimumSupportedVersion": "2.1.11"
  },
  "DataProtection": {
    "KeysPath": "DataProtectionKeys",
    "ApplicationName": "QuilvianSystemBackend"
  },
  "Jwt": {
    "Issuer": "QuilvianSystemBackend",
    "Audience": "QuilvianSystemFrontend",
    "CookieName": "quilvian_access_token",
    "ExpireMinutes": 60,
    "KioskExpireMinutes": 1440,
    "DeviceDefaultExpireMinutes": 129600,
    "DeviceMinExpireMinutes": 1440,
    "DeviceMaxExpireMinutes": 525600
  },
  "AuthCookie": {
    "Secure": true,
    "SameSite": "None",
    "Domain": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "https://dev.quilvian-mmchospital.com",
      "https://sta.quilvian-mmchospital.com",
      "https://quilvian-mmchospital.com"
    ]
  },
  "SeedSuperAdmin": {
    "Enabled": true,
    "Username": "superadmin",
    "Email": "superadmin@admin.com",
    "FullName": "SuperAdmin"
  },
  "SeedDefaultData": {
    "Enabled": true
  },
  "Seeders": {
    "RunPrescriptionReviewCriterionSeed": true,
    "RunEmergencyMasterDataSeed": false,
    "RunInpatientMasterDataSeed": false,
    "RunIcdSeed": false,
    "IcdFolderPath": "C:\\Users\\benar\\OneDrive\\Pictures\\ICD-Migration"
  },
  "FileStorage": {
    "UploadRootPath": "Storage/uploads",
    "PublicRequestPath": "/uploads",
    "PublicBaseUrl": "https://api-dev.quilvian-mmchospital.com",
    "DefaultUserProfilePhotoPath": "/uploads/default-profile-photos/user.png",
    "DefaultDoctorProfilePhotoPath": "/uploads/default-profile-photos/dokter.png",
    "ProfilePhotoFolderName": "profile-photo",
    "MaxProfilePhotoSizeMb": 2,
    "AllowedProfilePhotoExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp"
    ]
  },
  "PatientQrCode": {
    "LogoPath": "Storage/uploads/system-assets/logo-rsmmc.png"
  },
  "LoginGeofence": {
    "Enabled": true,
    "HospitalName": "RSMMC",
    "Latitude": -6.21984502881807,
    "Longitude": 106.83240137757149,
    "AllowedRadiusMeters": 1000,
    "MaxAccuracyMeters": 250,
    "ApplyToSuperAdmin": false
  },
  "AttendanceCapture": {
    "MaxAccuracyMeters": 250
  },
  "SerilogSettings": {
    "ServiceName": "quilvian-backend",
    "MinimumLevel": "Information",
    "MicrosoftMinimumLevel": "Warning",
    "MicrosoftAspNetCoreMinimumLevel": "Warning",
    "SystemMinimumLevel": "Warning",
    "LogDirectory": "Logs",
    "FileNamePattern": "quilvian-backend-.json",
    "RetainedFileCountLimit": 14,
    "EnableRequestLogging": true,
    "SlowRequestThresholdMs": 3000
  },
  "QueueVoice": {
    "Enabled": true,
    "CacheFolder": "Storage/QueueVoiceCache",
    "PiperExecutablePath": "/opt/piper/piper",
    "FfmpegExecutablePath": "ffmpeg",
    "DefaultVoiceCode": "id_ID_female_default",
    "Mp3Bitrate": "128k",
    "ProcessTimeoutSeconds": 30,
    "Voices": [
      {
        "VoiceCode": "id_ID_female_default",
        "DisplayName": "Indonesia Female - Default",
        "Gender": "Female",
        "Language": "id-ID",
        "ModelPath": "Storage/PiperVoices/id_ID/female/default.onnx",
        "LengthScale": 1.08,
        "NoiseScale": 0.65,
        "NoiseW": 0.8,
        "Volume": 1.15
      },
      {
        "VoiceCode": "id_ID_male_default",
        "DisplayName": "Indonesia Male - Default",
        "Gender": "Male",
        "Language": "id-ID",
        "ModelPath": "Storage/PiperVoices/id_ID/male/default.onnx",
        "LengthScale": 1.1,
        "NoiseScale": 0.65,
        "NoiseW": 0.8,
        "Volume": 1.15
      }
    ]
  },
  "Swagger": {
    "Enabled": true,
    "EnableInProduction": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Billing": {
    "PaymentProvider": {
      "AutoAcceptWithoutProvider": true
    }
  },
  "HealthServices": {
    "EmergencyTriageSlaMonitor": {
      "Enabled": false,
      "PollIntervalSeconds": 60,
      "BatchSize": 500
    }
  },
  "OperatingRoom": {
    "Scheduling": {
      "DefaultBufferBeforeMinutes": 15,
      "DefaultBufferAfterMinutes": 30,
      "MinimumDurationMinutes": 15,
      "MaximumDurationMinutes": 1440
    }
  },
  "Security": {
    "Authorization": {
      "EnforceClinicalPolicyForSuperAdmin": false
    }
  },
  "HumanResource": {
    "WorkflowAttachment": {
      "RelativeRootPath": "Storage/uploads/human-resource/workflow",
      "MaximumFileSizeBytes": 20971520,
      "AllowedExtensions": [
        ".pdf",
        ".jpg",
        ".jpeg",
        ".png",
        ".webp",
        ".doc",
        ".docx",
        ".xls",
        ".xlsx",
        ".csv",
        ".txt",
        ".zip"
      ]
    },
    "AttendanceScheduler": {
      "Enabled": true,
      "PollIntervalSeconds": 30,
      "AutoEnqueueDailyProcessing": true,
      "AutoClosePeriods": false,
      "TimeZoneId": "Asia/Jakarta",
      "DailyProcessingHour": 2,
      "DailyProcessingMinute": 15,
      "ProcessDaysBack": 1,
      "MaximumCatchUpDays": 7,
      "DefaultMaximumRetryCount": 3,
      "RetryDelayMinutes": 15,
      "RunningJobTimeoutMinutes": 60,
      "SystemActorUserId": null,
      "WorkerInstanceName": "quilvian-attendance-scheduler"
    },
    "LeaveAccrualScheduler": {
      "Enabled": true,
      "PollIntervalSeconds": 60,
      "AutoEnqueueDueAccruals": true,
      "TimeZoneId": "Asia/Jakarta",
      "DailyEnqueueHour": 1,
      "DailyEnqueueMinute": 30,
      "LookBackDays": 3,
      "DefaultMaximumRetryCount": 3,
      "RunningRunTimeoutMinutes": 60,
      "SystemActorUserId": null,
      "WorkerInstanceName": "quilvian-leave-accrual-scheduler"
    },
    "LeaveCarryForwardScheduler": {
      "Enabled": true,
      "PollIntervalSeconds": 60,
      "AutoEnqueueDueCarryForward": true,
      "AutoProcessDueExpiry": true,
      "TimeZoneId": "Asia/Jakarta",
      "DailyEnqueueHour": 2,
      "DailyEnqueueMinute": 0,
      "LookBackDays": 7,
      "DefaultMaximumRetryCount": 3,
      "RunningRunTimeoutMinutes": 120,
      "ExpiryBatchSize": 500,
      "SystemActorUserId": null,
      "WorkerInstanceName": "quilvian-leave-carry-forward-scheduler"
    },
    "LeaveExecutionScheduler": {
      "Enabled": true,
      "PollIntervalSeconds": 60,
      "AutoProcessDueLeave": true,
      "TimeZoneId": "Asia/Jakarta",
      "DailyProcessingHour": 0,
      "DailyProcessingMinute": 30,
      "LookBackDays": 7,
      "MaximumBatchSize": 500,
      "SystemActorUserId": null,
      "WorkerInstanceName": "quilvian-leave-execution-scheduler"
    },
    "LeavePayrollIntegration": {
      "Enabled": true,
      "AutoCreateAttendanceInputs": true,
      "AutoCreateLeaveAllowanceVariableInputs": false,
      "AutoCreateEncashmentVariableInputs": true,
      "SubmitVariableInputs": false,
      "LeaveAllowancePayrollComponentCode": "LEAVE_ALLOWANCE",
      "LeaveEncashmentPayrollComponentCode": "LEAVE_ENCASHMENT",
      "CurrencyCode": "IDR",
      "MaximumItemPerExecution": 1000
    }
  }
}

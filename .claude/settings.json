{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(dotnet build:*)"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-no-auto-push.mjs\"; [ -f \"$f\" ] || f=\"${CLAUDE_PROJECT_DIR:-.}/QuilvianBackend/.claude/hooks/guard-no-auto-push.mjs\"; [ -f \"$f\" ] || exit 0; node \"$f\"",
            "statusMessage": "Memeriksa larangan push backend",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

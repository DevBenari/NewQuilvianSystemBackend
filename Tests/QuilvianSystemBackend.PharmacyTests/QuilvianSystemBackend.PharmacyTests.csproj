<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>QuilvianSystemBackend.PharmacyTests</AssemblyName>
    <RootNamespace>QuilvianSystemBackend.Tests.Pharmacy</RootNamespace>

    <!--
      Proyek uji tidak pernah menjalankan perkakas EF, jadi Designer dan snapshot migration
      tidak perlu ikut dikompilasi. Tanpa ini satu build menyeret 6,7 juta baris generated code
      milik proyek utama dan memakan waktu sekitar satu jam.
    -->
    <SkipMigrationMetadata>true</SkipMigrationMetadata>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.18" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\QuilvianSystemBackend.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c5cea89b-03e0-4326-8dc2-62ee00ae859d</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    Project test berada di tests\ dan bukan bagian dari project web ini.
    Karena SDK Web mengikutsertakan seluruh berkas .cs di bawah root secara otomatis,
    folder tests\ wajib dikecualikan agar tidak ikut terkompilasi ke dalam aplikasi.
  -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Areas\HealthServices\DeviceManagement\**" />
    <Compile Remove="Areas\HealthServices\PatientManagement\Controllers\**" />
    <Compile Remove="Areas\HealthServices\PatientManagement\DTOs\**" />
    <Compile Remove="Areas\HealthServices\PatientManagement\PatientMember\**" />
    <Compile Remove="Areas\HealthServices\PatientManagement\Patient\**" />
    <Compile Remove="Areas\SelfServices\Models\**" />
    <Compile Remove="Areas\SelfServices\Views\**" />
    <Content Remove="Areas\HealthServices\DeviceManagement\**" />
    <Content Remove="Areas\HealthServices\PatientManagement\Controllers\**" />
    <Content Remove="Areas\HealthServices\PatientManagement\DTOs\**" />
    <Content Remove="Areas\HealthServices\PatientManagement\PatientMember\**" />
    <Content Remove="Areas\HealthServices\PatientManagement\Patient\**" />
    <Content Remove="Areas\SelfServices\Models\**" />
    <Content Remove="Areas\SelfServices\Views\**" />
    <EmbeddedResource Remove="Areas\HealthServices\DeviceManagement\**" />
    <EmbeddedResource Remove="Areas\HealthServices\PatientManagement\Controllers\**" />
    <EmbeddedResource Remove="Areas\HealthServices\PatientManagement\DTOs\**" />
    <EmbeddedResource Remove="Areas\HealthServices\PatientManagement\PatientMember\**" />
    <EmbeddedResource Remove="Areas\HealthServices\PatientManagement\Patient\**" />
    <EmbeddedResource Remove="Areas\SelfServices\Models\**" />
    <EmbeddedResource Remove="Areas\SelfServices\Views\**" />
    <None Remove="Areas\HealthServices\DeviceManagement\**" />
    <None Remove="Areas\HealthServices\PatientManagement\Controllers\**" />
    <None Remove="Areas\HealthServices\PatientManagement\DTOs\**" />
    <None Remove="Areas\HealthServices\PatientManagement\PatientMember\**" />
    <None Remove="Areas\HealthServices\PatientManagement\Patient\**" />
    <None Remove="Areas\SelfServices\Models\**" />
    <None Remove="Areas\SelfServices\Views\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.18" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.18">

      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.18" />

    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.18.1" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />

    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="6.1.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="3.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="version.json">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>


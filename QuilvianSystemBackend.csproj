<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>c5cea89b-03e0-4326-8dc2-62ee00ae859d</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>.</DockerfileContext>
		<PlatformTarget>x64</PlatformTarget>

		<!--
		  Folder test terpisah dari web project.
		  Tidak boleh ikut compile ke aplikasi utama.
		-->
		<DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>


		<!--
		  XML documentation hanya untuk Development.
		  Release dimatikan untuk mempercepat build.
		-->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>

	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">

		<DebugType>None</DebugType>
		<DebugSymbols>false</DebugSymbols>

		<GenerateDocumentationFile>false</GenerateDocumentationFile>

		<RunAnalyzers>false</RunAnalyzers>

	</PropertyGroup>

	<!-- =========================================================
	     BUILD PERFORMANCE OPTIMIZATION
	     =========================================================
	     
	     Migration tetap ada di repository untuk:
	     - dotnet ef migrations add
	     - dotnet ef database update
	     - database maintenance

	     Tetapi tidak perlu ikut dikompilasi oleh aplikasi utama.

	     Folder Migration sangat besar:
	     - ratusan file migration
	     - Designer.cs jutaan baris generated code
	     - ModelSnapshot besar

	     Exclude dari Compile mengurangi waktu build.
	-->
	<ItemGroup>

		<!--
    Migration Designer files adalah generated code besar.
    Tidak diperlukan saat compile aplikasi.
    Migration utama tetap dipertahankan agar EF Core tetap bekerja.
    -->

		<!--
		  DUA BARIS DI BAWAH SENGAJA DINONAKTIFKAN 2026-09-04.

		  <Compile Remove="Migrations\**\*.Designer.cs" />
		  <Compile Remove="Migrations\ApplicationDbContextModelSnapshot.cs" />

		  Keduanya mempercepat build, tetapi harganya adalah EF Core yang berhenti
		  mengenali migration-nya sendiri.

		  Designer.cs memuat atribut [Migration("...")]. Tanpa dikompilasi, seluruh
		  migration hasil scaffold - yaitu semua migration sejak 2026-09-01 - menjadi
		  TIDAK TERLIHAT oleh EF: 'dotnet ef migrations list' hanya menampilkan 7 dari
		  puluhan migration, yakni yang atributnya ditulis tangan di berkas utamanya.
		  Akibatnya 'database update' tidak menerapkan apa pun dan tetap menjawab 'Done.'

		  ApplicationDbContextModelSnapshot.cs adalah pembanding yang dipakai EF saat
		  menyusun migration baru. Tanpa dikompilasi, EF menganggap belum ada schema
		  sama sekali lalu menghasilkan migration berisi SELURUH database - satu kali
		  terukur 70.815 baris - tanpa satu pun peringatan.

		  Keduanya tidak terasa selama bin/ masih menyimpan hasil build lama yang
		  memuat kedua berkas itu. Begitu ada full rebuild, kemampuan EF hilang diam-diam.
		-->

	</ItemGroup>

	<ItemGroup>

		<Compile Remove="Areas\HealthServices\DeviceManagement\**" />
		<Compile Remove="Areas\HealthServices\PatientManagement\Controllers\**" />
		<Compile Remove="Areas\HealthServices\PatientManagement\DTOs\**" />
